---
import siteSettings from '@/content/settings.json';
import homepageData from '@/content/homepage.json';

interface Props {
  locale: 'en' | 'fr';
  variant?: 'pill' | 'bar' | 'inline';
  asLink?: boolean;
}

const { locale, variant = 'pill', asLink = true } = Astro.props;
const isFr = locale === 'fr';
const s = siteSettings;
const h = homepageData;
const rating = h.googleRating || "5.0";
const stars = Array.from({ length: 5 });
---

{asLink ? (
  <a
    href={s.googleUrl}
    target="_blank"
    rel="noopener noreferrer"
    class:list={[
      'touch-target inline-flex items-center gap-2 transition-all duration-200 focus-visible:ring-2 focus-visible:ring-midnight-indigo focus-visible:ring-offset-2',
      variant === 'pill' && 'rounded-full bg-midnight-indigo/10 px-3.5 py-1.5 border border-midnight-indigo/20 hover:bg-midnight-indigo/20',
      variant === 'bar' && 'slide-up block rounded-xl bg-midnight-indigo px-6 py-4 text-text-on-dark hover:bg-midnight-indigo-dark hover:shadow-lg group w-full',
      variant === 'inline' && 'rounded-full bg-midnight-indigo/10 px-3.5 py-1.5 border border-midnight-indigo/20 hover:bg-midnight-indigo/20',
    ]}
    aria-label={isFr ? 'Voir nos avis Google (ouvre une nouvelle fenêtre)' : 'See our Google Reviews (opens in new window)'}
  >
    <!-- Official 4-color Google G Logo -->
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
      <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
      <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
      <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
      <path fill="#EA4335" d="M12 4.39c1.7 0 3.22.58 4.42 1.73l3.31-3.31C17.71 1.05 15.09 0 12 0 8.04 0 4.52 2.62 2.62 6.19l3.3 2.57C6.88 6.5 9.53 4.39 12 4.39z"/>
    </svg>

    <div class="flex gap-0.5" role="img" aria-label={`${rating} out of 5 stars`}>
      {stars.map(() => (
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-amber-500 fill-amber-500 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
      ))}
    </div>

    <span class="text-xs font-bold text-navy">{rating}</span>
  </a>
) : (
  <span class:list={[
    'inline-flex items-center gap-2',
    variant === 'pill' && 'rounded-full bg-midnight-indigo/10 px-3.5 py-1.5 border border-midnight-indigo/20',
    variant === 'inline' && 'rounded-full bg-midnight-indigo/10 px-3.5 py-1.5 border border-midnight-indigo/20',
  ]}>
    <!-- Official 4-color Google G Logo -->
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
      <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
      <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
      <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
      <path fill="#EA4335" d="M12 4.39c1.7 0 3.22.58 4.42 1.73l3.31-3.31C17.71 1.05 15.09 0 12 0 8.04 0 4.52 2.62 2.62 6.19l3.3 2.57C6.88 6.5 9.53 4.39 12 4.39z"/>
    </svg>

    <div class="flex gap-0.5" role="img" aria-label={`${rating} out of 5 stars`}>
      {stars.map(() => (
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-amber-500 fill-amber-500 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
      ))}
    </div>

    <span class="text-xs font-bold text-navy">{rating}</span>
  </span>
)}
