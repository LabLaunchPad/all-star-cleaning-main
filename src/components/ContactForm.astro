---
// src/components/ContactForm.astro
import siteSettings from '@/content/settings.json';

interface Props {
  locale: 'en' | 'fr';
  idPrefix?: string;
  title?: string;
  subtitle?: string;
}

const { locale, idPrefix = 'form-', title, subtitle } = Astro.props;
const isFr = locale === 'fr';
const web3formsKey = import.meta.env.WEB3FORMS_ACCESS_KEY || (siteSettings as Record<string, any>).web3formsKey || 'YOUR_ACCESS_KEY_HERE';

const defaultTitle = isFr ? 'Obtenez Votre Devis Gratuit' : 'Request Your Free Quote';
const defaultSubtitle = isFr ? 'Remplissez le formulaire ci-dessous et nous vous répondrons dans les 24 heures.' : 'Fill out the form below and we\'ll get back to you within 24 hours.';
---
<div class="rounded-2xl border border-border bg-card p-6 md:p-10 shadow-sm">
  <div class="text-center max-w-2xl mx-auto mb-8">
    <h2 class="font-heading heading-section font-bold text-navy">{title || defaultTitle}</h2>
    <p class="mt-2 text-muted-foreground">{subtitle || defaultSubtitle}</p>
  </div>

  <form
    id={`${idPrefix}contact-form`}
    action="https://api.web3forms.com/submit"
    method="POST"
    class="space-y-6 max-w-3xl mx-auto"
  >
    <input type="hidden" name="access_key" value={web3formsKey} />
    <input type="hidden" name="subject" value={isFr ? 'Nouvelle demande de devis — All Star Cleaning' : 'New Quote Request — All Star Cleaning'} />
    <input type="hidden" name="from_name" value="All Star Cleaning Website" />
    <input type="checkbox" name="botcheck" class="hidden" style="display: none" />

    <div class="grid gap-6 sm:grid-cols-2">
      <div>
        <label for={`${idPrefix}name`} class="block text-sm font-medium text-navy">{isFr ? 'Nom complet' : 'Full Name'} *</label>
        <input
          type="text"
          id={`${idPrefix}name`}
          name="name"
          required
          aria-required="true"
          autocomplete="name"
          class="mt-1.5 block w-full rounded-xl border border-border bg-white px-4 py-3 text-navy placeholder-muted-foreground/60 transition-colors focus:border-midnight-indigo focus:outline-none focus:ring-2 focus:ring-midnight-indigo/20"
          placeholder={isFr ? 'Jean Tremblay' : 'John Smith'}
        />
      </div>
      <div>
        <label for={`${idPrefix}email`} class="block text-sm font-medium text-navy">{isFr ? 'Courriel' : 'Email'} *</label>
        <input
          type="email"
          id={`${idPrefix}email`}
          name="email"
          required
          aria-required="true"
          inputmode="email"
          autocomplete="email"
          class="mt-1.5 block w-full rounded-xl border border-border bg-white px-4 py-3 text-navy placeholder-muted-foreground/60 transition-colors focus:border-midnight-indigo focus:outline-none focus:ring-2 focus:ring-midnight-indigo/20"
          placeholder={isFr ? 'jean@exemple.com' : 'john@example.com'}
        />
      </div>
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      <div>
        <label for={`${idPrefix}phone`} class="block text-sm font-medium text-navy">{isFr ? 'Téléphone' : 'Phone'}</label>
        <input
          type="tel"
          id={`${idPrefix}phone`}
          name="phone"
          inputmode="tel"
          autocomplete="tel"
          class="mt-1.5 block w-full rounded-xl border border-border bg-white px-4 py-3 text-navy placeholder-muted-foreground/60 transition-colors focus:border-midnight-indigo focus:outline-none focus:ring-2 focus:ring-midnight-indigo/20"
          placeholder="(613) 555-0123"
        />
      </div>
      <div>
        <label for={`${idPrefix}service`} class="block text-sm font-medium text-navy">{isFr ? 'Service souhaité' : 'Service Needed'} *</label>
        <select
          id={`${idPrefix}service`}
          name="service"
          required
          aria-required="true"
          class="mt-1.5 block w-full rounded-xl border border-border bg-white px-4 py-3 text-navy transition-colors focus:border-midnight-indigo focus:outline-none focus:ring-2 focus:ring-midnight-indigo/20"
        >
          <option value="">{isFr ? '— Sélectionnez un service —' : '— Select a service —'}</option>
          <option value="window-cleaning">{isFr ? 'Nettoyage de vitres' : 'Window Cleaning'}</option>
          <option value="gutter-cleaning">{isFr ? 'Nettoyage de gouttières' : 'Gutter Cleaning'}</option>
          <option value="pressure-washing">{isFr ? 'Lavage sous pression' : 'Pressure Washing'}</option>
          <option value="siding-cleaning">{isFr ? 'Nettoyage de revêtement' : 'Siding Cleaning'}</option>
          <option value="other">{isFr ? 'Autre' : 'Other'}</option>
        </select>
      </div>
    </div>

    <div>
      <label for={`${idPrefix}address`} class="block text-sm font-medium text-navy">{isFr ? 'Adresse de la propriété' : 'Property Address'}</label>
      <input
        type="text"
        id={`${idPrefix}address`}
        name="address"
        autocomplete="street-address"
        class="mt-1.5 block w-full rounded-xl border border-border bg-white px-4 py-3 text-navy placeholder-muted-foreground/60 transition-colors focus:border-midnight-indigo focus:outline-none focus:ring-2 focus:ring-midnight-indigo/20"
        placeholder={isFr ? '123 rue Example, Ottawa, ON' : '123 Example St, Ottawa, ON'}
      />
    </div>

    <div>
      <label for={`${idPrefix}message`} class="block text-sm font-medium text-navy">{isFr ? 'Décrivez vos besoins' : 'Tell us about your project'} *</label>
      <textarea
        id={`${idPrefix}message`}
        name="message"
        required
        aria-required="true"
        rows={4}
        class="mt-1.5 block w-full rounded-xl border border-border bg-white px-4 py-3 text-navy placeholder-muted-foreground/60 transition-colors focus:border-midnight-indigo focus:outline-none focus:ring-2 focus:ring-midnight-indigo/20 resize-y"
        placeholder={isFr ? 'Nombre de fenêtres, hauteur des gouttières, type de surface à laver, etc.' : 'Number of windows, gutter height, surface type to wash, etc.'}
      ></textarea>
    </div>

    <div id={`${idPrefix}form-status`} class="hidden rounded-xl p-4 text-sm font-medium"></div>

    <button
      type="submit"
      class="touch-target w-full rounded-full bg-midnight-indigo px-8 py-4 text-base font-bold text-white shadow-md transition-all hover:bg-midnight-indigo-dark hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-midnight-indigo"
    >
      {isFr ? 'Envoyer la Demande' : 'Submit Request'}
    </button>
  </form>
</div>

<script is:inline define:vars={{ formId: `${idPrefix}contact-form`, statusId: `${idPrefix}form-status` }}>
  // @ts-nocheck
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById(formId);
    const statusDiv = document.getElementById(statusId);
    const submitBtn = form ? form.querySelector('button[type="submit"]') : null;

    if (!form || !statusDiv || !submitBtn) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const originalBtnText = submitBtn.textContent;
      const isFr = document.documentElement.lang === 'fr';

      submitBtn.disabled = true;
      submitBtn.textContent = isFr ? 'Envoi en cours...' : 'Sending...';

      statusDiv.classList.add('hidden');
      statusDiv.className = 'hidden rounded-xl p-4 text-sm font-medium';

      try {
        const formData = new FormData(form);
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData
        });

        const data = await response.json();

        if (data.success) {
          form.reset();
          statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-green-surface text-green-dark border border-green-light/30 block';
          statusDiv.textContent = isFr 
            ? 'Merci! Votre demande de devis a été envoyée avec succès. Nous vous contacterons dans les 24 heures.'
            : 'Thank you! Your quote request has been sent successfully. We will contact you within 24 hours.';
        } else {
          throw new Error(data.message || 'Submission failed');
        }
      } catch (err) {
        console.error('Web3Forms submit error:', err);
        statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-destructive/10 text-destructive border border-destructive/20 block';
        statusDiv.textContent = isFr 
          ? 'Désolé, une erreur est survenue lors de l\'envoi. Veuillez réessayer ou nous appeler directement.'
          : 'Sorry, there was an error submitting your request. Please try again or call us directly.';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalBtnText;
      }
    });
  });
</script>
