---
// src/components/ContactForm.astro
import siteSettings from '@/content/settings.json';

interface Props {
  locale: 'en' | 'fr';
  idPrefix?: string;
  title?: string;
  subtitle?: string;
}

const { locale, idPrefix = 'form-', title, subtitle } = Astro.props;
const isFr = locale === 'fr';
const s = siteSettings;
const web3formsKey = import.meta.env.WEB3FORMS_ACCESS_KEY || (siteSettings as Record<string, any>).web3formsKey || 'YOUR_ACCESS_KEY_HERE';

const defaultTitle = isFr ? 'Obtenez Votre Devis Gratuit' : 'Request Your Free Quote';
const defaultSubtitle = isFr ? 'Remplissez le formulaire ci-dessous et nous vous répondrons dans les 24 heures.' : 'Fill out the form below and we\'ll get back to you within 24 hours.';

const serviceChips = [
  { id: 'window-cleaning', label: isFr ? 'Vitres' : 'Window Cleaning', icon: 'window' },
  { id: 'gutter-cleaning', label: isFr ? 'Gouttières' : 'Gutter Cleaning', icon: 'gutter' },
  { id: 'pressure-washing', label: isFr ? 'Pression' : 'Pressure Wash', icon: 'sparkle' },
  { id: 'siding-cleaning', label: isFr ? 'Revêtement' : 'Siding Clean', icon: 'home' },
];
---

<div class="relative overflow-hidden rounded-3xl border border-midnight-indigo/15 bg-gradient-to-b from-card/60 via-white to-card/40 p-5 sm:p-7 lg:p-8 shadow-xl max-w-5xl mx-auto">
  <!-- Soft background accent blur -->
  <div class="pointer-events-none absolute -right-20 -top-20 h-72 w-72 rounded-full bg-midnight-indigo/5 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-20 -left-20 h-72 w-72 rounded-full bg-sky-light/10 blur-3xl" aria-hidden="true"></div>

  <div class="relative z-10 grid gap-6 lg:grid-cols-12 lg:gap-8 items-start">
    <!-- Left Column: Trust Pillars & Value Proposition -->
    <div class="lg:col-span-5 flex flex-col justify-start order-2 lg:order-1">
      <div class="hidden lg:block">
        <!-- Badges Row: 60s Request + Direct Call Link -->
        <div class="flex flex-wrap items-center gap-2">
          <div class="inline-flex items-center gap-1.5 rounded-full bg-midnight-indigo/10 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-midnight-indigo">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-midnight-indigo" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m13 2-2 10h7L7 22l2-10H2z"/></svg>
            <span>{isFr ? 'Devis Gratuit En 60s' : 'Fast 60s Request'}</span>
          </div>

          <a
            href={`tel:${s.phoneLink}`}
            class="touch-target group inline-flex items-center gap-1.5 rounded-full border border-midnight-indigo/20 bg-white/80 px-3 py-1 text-[11px] font-bold text-navy shadow-sm transition-all hover:bg-midnight-indigo/10 hover:border-midnight-indigo/40"
            aria-label={isFr ? `Appeler All Star Cleaning au ${s.phone}` : `Call All Star Cleaning at ${s.phone}`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-midnight-indigo transition-transform group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>{isFr ? 'Appel :' : 'Call:'} <span class="text-midnight-indigo">{s.phone}</span></span>
          </a>
        </div>

        <h2 class="mt-3 font-heading text-xl font-bold tracking-tight text-navy sm:text-2xl lg:text-3xl">
          {title || defaultTitle}
        </h2>
        <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
          {subtitle || defaultSubtitle}
        </p>

        <!-- Trust Pillars List -->
        <div class="mt-5 space-y-2.5">
          <!-- Pillar 1 -->
          <div class="flex items-start gap-3 rounded-xl border border-border/60 bg-white/80 p-3 shadow-sm backdrop-blur-sm transition-transform duration-200 hover:-translate-y-0.5">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-midnight-indigo/10 text-midnight-indigo">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div>
              <h3 class="font-heading text-xs font-bold text-navy">{isFr ? 'Garantie Réponse 24h' : '24-Hour Reply Guarantee'}</h3>
              <p class="mt-0.5 text-[11px] leading-relaxed text-muted-foreground">{isFr ? 'Estimation claire et détaillée envoyée sans délai.' : 'Clear, itemized estimate delivered straight to your inbox.'}</p>
            </div>
          </div>

          <!-- Pillar 2 -->
          <div class="flex items-start gap-3 rounded-xl border border-border/60 bg-white/80 p-3 shadow-sm backdrop-blur-sm transition-transform duration-200 hover:-translate-y-0.5">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-emerald-subtle text-emerald-bold">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
            </div>
            <div>
              <h3 class="font-heading text-xs font-bold text-navy">{isFr ? 'Garantie Satisfaction 100%' : '100% Satisfaction Guarantee'}</h3>
              <p class="mt-0.5 text-[11px] leading-relaxed text-muted-foreground">{isFr ? 'Si vous n\'êtes pas satisfait, nous revenons gratuitement.' : 'If you\'re not completely satisfied, we come back for free.'}</p>
            </div>
          </div>

          <!-- Pillar 3 -->
          <div class="flex items-start gap-3 rounded-xl border border-border/60 bg-white/80 p-3 shadow-sm backdrop-blur-sm transition-transform duration-200 hover:-translate-y-0.5">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-amber-subtle text-amber-bold">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            </div>
            <div>
              <h3 class="font-heading text-xs font-bold text-navy">{isFr ? 'Note 5.0/5 sur Google' : '5.0 Rating on Google'}</h3>
              <p class="mt-0.5 text-[11px] leading-relaxed text-muted-foreground">{isFr ? 'La référence de confiance à Ottawa.' : 'Trusted by hundreds of homeowners across Ottawa.'}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom Call Banner: Phone only -->
      <div class="mt-0 lg:mt-5 rounded-xl border border-midnight-indigo/20 bg-midnight-indigo/5 p-4">
        <p class="text-[11px] font-semibold uppercase tracking-wider text-midnight-indigo mb-2.5">
          {isFr ? 'Préférez-vous nous appeler ?' : 'Prefer to reach us directly?'}
        </p>
        <a
          href={`tel:${s.phoneLink}`}
          class="touch-target group flex w-full items-center justify-center gap-1.5 rounded-full bg-midnight-indigo px-3 py-2 text-xs font-bold text-white shadow-sm transition-all hover:bg-midnight-indigo-dark hover:shadow-md"
          aria-label={isFr ? `Appeler All Star Cleaning au ${s.phone}` : `Call All Star Cleaning at ${s.phone}`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 transition-transform group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>{s.phone}</span>
        </a>
      </div>
    </div>

    <!-- Right Column: Interactive Form Card -->
    <div class="lg:col-span-7 order-1 lg:order-2">
      <div class="rounded-xl border border-border/80 bg-white p-4 sm:p-6 shadow-md">
        <form
          id={`${idPrefix}contact-form`}
          action="https://api.web3forms.com/submit"
          method="POST"
          class="space-y-3.5"
        >
          <input type="hidden" name="access_key" value={web3formsKey} />
          <input type="hidden" name="subject" value={isFr ? 'Nouvelle demande de devis — All Star Cleaning' : 'New Quote Request — All Star Cleaning'} />
          <input type="hidden" name="from_name" value="All Star Cleaning Website" />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none" />

          <!-- Interactive Service Selector Chips -->
          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-navy mb-1.5">
              {isFr ? '1. Choisissez un service' : '1. Select a service'} <span class="text-midnight-indigo">*</span>
            </label>
            <div class="grid grid-cols-2 gap-1.5 sm:grid-cols-4" id={`${idPrefix}service-chips-container`}>
              {serviceChips.map((chip) => (
                <button
                  type="button"
                  data-service-chip={chip.id}
                  class="touch-target group flex flex-col items-center justify-center rounded-lg border border-border/80 bg-card/50 p-2 text-center transition-all hover:border-midnight-indigo/50 hover:bg-midnight-indigo/5 focus:outline-none focus:ring-2 focus:ring-midnight-indigo/20"
                >
                  {chip.icon === 'window' && (
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5 text-midnight-indigo transition-transform group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 12h18"/><path d="M12 3v18"/></svg>
                  )}
                  {chip.icon === 'gutter' && (
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5 text-amber-bold transition-transform group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                  )}
                  {chip.icon === 'sparkle' && (
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5 text-emerald-bold transition-transform group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
                  )}
                  {chip.icon === 'home' && (
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5 text-sky-bold transition-transform group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                  )}
                  <span class="mt-1 text-[11px] font-semibold text-navy">{chip.label}</span>
                </button>
              ))}
            </div>

            <!-- Synchronized Select Field -->
            <div class="mt-2">
              <select
                id={`${idPrefix}service`}
                name="service"
                required
                aria-required="true"
                class="block w-full rounded-lg border border-border/80 bg-white px-3 py-2 text-xs sm:text-sm text-navy transition-all focus:border-midnight-indigo focus:outline-none focus:ring-2 focus:ring-midnight-indigo/20"
              >
                <option value="">{isFr ? '— Ou sélectionnez dans la liste —' : '— Or select from list —'}</option>
                <option value="window-cleaning">{isFr ? 'Nettoyage de vitres' : 'Window Cleaning'}</option>
                <option value="gutter-cleaning">{isFr ? 'Nettoyage de gouttières' : 'Gutter Cleaning'}</option>
                <option value="pressure-washing">{isFr ? 'Lavage sous pression' : 'Pressure Washing'}</option>
                <option value="siding-cleaning">{isFr ? 'Nettoyage de revêtement' : 'Siding Cleaning'}</option>
                <option value="other">{isFr ? 'Autre service' : 'Other service'}</option>
              </select>
            </div>
          </div>

          <!-- Section Label -->
          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-navy mb-1.5">
              {isFr ? '2. Vos coordonnées' : '2. Your contact details'}
            </label>

            <div class="grid gap-3 sm:grid-cols-2">
              <div>
                <label for={`${idPrefix}name`} class="block text-[11px] font-medium text-navy">{isFr ? 'Nom complet' : 'Full Name'} *</label>
                <input
                  type="text"
                  id={`${idPrefix}name`}
                  name="name"
                  required
                  aria-required="true"
                  autocomplete="name"
                  class="mt-1 block w-full rounded-lg border border-border/80 bg-card/30 px-3 py-2 text-xs sm:text-sm text-navy placeholder-muted-foreground/50 transition-all focus:bg-white focus:border-midnight-indigo focus:outline-none focus:ring-2 focus:ring-midnight-indigo/20"
                  placeholder={isFr ? 'Jean Tremblay' : 'John Smith'}
                />
              </div>
              <div>
                <label for={`${idPrefix}email`} class="block text-[11px] font-medium text-navy">{isFr ? 'Courriel' : 'Email'} *</label>
                <input
                  type="email"
                  id={`${idPrefix}email`}
                  name="email"
                  required
                  aria-required="true"
                  inputmode="email"
                  autocomplete="email"
                  class="mt-1 block w-full rounded-lg border border-border/80 bg-card/30 px-3 py-2 text-xs sm:text-sm text-navy placeholder-muted-foreground/50 transition-all focus:bg-white focus:border-midnight-indigo focus:outline-none focus:ring-2 focus:ring-midnight-indigo/20"
                  placeholder={isFr ? 'jean@exemple.com' : 'john@example.com'}
                />
              </div>
            </div>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            <div>
              <label for={`${idPrefix}phone`} class="block text-[11px] font-medium text-navy">{isFr ? 'Téléphone' : 'Phone'}</label>
              <input
                type="tel"
                id={`${idPrefix}phone`}
                name="phone"
                inputmode="tel"
                autocomplete="tel"
                class="mt-1 block w-full rounded-lg border border-border/80 bg-card/30 px-3 py-2 text-xs sm:text-sm text-navy placeholder-muted-foreground/50 transition-all focus:bg-white focus:border-midnight-indigo focus:outline-none focus:ring-2 focus:ring-midnight-indigo/20"
                placeholder="(613) 555-0123"
              />
            </div>
            <div>
              <label for={`${idPrefix}address`} class="block text-[11px] font-medium text-navy">{isFr ? 'Adresse de la propriété' : 'Property Address'}</label>
              <input
                type="text"
                id={`${idPrefix}address`}
                name="address"
                autocomplete="street-address"
                class="mt-1 block w-full rounded-lg border border-border/80 bg-card/30 px-3 py-2 text-xs sm:text-sm text-navy placeholder-muted-foreground/50 transition-all focus:bg-white focus:border-midnight-indigo focus:outline-none focus:ring-2 focus:ring-midnight-indigo/20"
                placeholder={isFr ? '123 rue Example, Ottawa' : '123 Example St, Ottawa'}
              />
            </div>
          </div>

          <div>
            <label for={`${idPrefix}message`} class="block text-[11px] font-medium text-navy">{isFr ? 'Décrivez vos besoins' : 'Tell us about your project'} *</label>
            <textarea
              id={`${idPrefix}message`}
              name="message"
              required
              aria-required="true"
              rows={2}
              class="mt-1 block w-full rounded-lg border border-border/80 bg-card/30 px-3 py-2 text-xs sm:text-sm text-navy placeholder-muted-foreground/50 transition-all focus:bg-white focus:border-midnight-indigo focus:outline-none focus:ring-2 focus:ring-midnight-indigo/20 resize-y"
              placeholder={isFr ? 'Nombre de fenêtres, hauteur des gouttières, type de surface, etc.' : 'Number of windows, gutter height, surface type, etc.'}
            ></textarea>
          </div>

          <div id={`${idPrefix}form-status`} class="hidden rounded-lg p-3 text-xs font-medium"></div>

          <div class="flex flex-col items-center sm:items-start">
            <button
              type="submit"
              class="touch-target group inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-full bg-midnight-indigo px-6 py-3 text-sm font-bold text-white shadow-blue-glow transition-all duration-200 hover:bg-midnight-indigo-dark hover:shadow-xl hover:scale-[1.01] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-midnight-indigo"
            >
              <span>{isFr ? 'Obtenir Mon Devis Gratuit' : 'Get My Free Quote'}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </button>
            <p class="mt-2 text-[11px] text-muted-foreground text-center sm:text-left">
              🔒 {isFr ? 'Sans engagement • Vos données restent confidentielles' : '100% Free & zero obligation • We respect your privacy'}
            </p>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ formId: `${idPrefix}contact-form`, statusId: `${idPrefix}form-status`, selectId: `${idPrefix}service`, containerId: `${idPrefix}service-chips-container` }}>
  // @ts-nocheck
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById(formId);
    const statusDiv = document.getElementById(statusId);
    const selectElem = document.getElementById(selectId);
    const chipsContainer = document.getElementById(containerId);
    const submitBtn = form ? form.querySelector('button[type="submit"]') : null;

    if (chipsContainer && selectElem) {
      const chips = chipsContainer.querySelectorAll('[data-service-chip]');
      
      const updateActiveChip = (selectedVal) => {
        chips.forEach((chip) => {
          const val = chip.getAttribute('data-service-chip');
          if (val === selectedVal) {
            chip.classList.remove('border-border/80', 'bg-card/50');
            chip.classList.add('border-midnight-indigo', 'bg-midnight-indigo/10', 'ring-2', 'ring-midnight-indigo/30');
          } else {
            chip.classList.remove('border-midnight-indigo', 'bg-midnight-indigo/10', 'ring-2', 'ring-midnight-indigo/30');
            chip.classList.add('border-border/80', 'bg-card/50');
          }
        });
      };

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const val = chip.getAttribute('data-service-chip');
          if (selectElem) {
            selectElem.value = val;
            updateActiveChip(val);
          }
        });
      });

      selectElem.addEventListener('change', (e) => {
        updateActiveChip(e.target.value);
      });
    }

    if (!form || !statusDiv || !submitBtn) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const originalBtnText = submitBtn.querySelector('span') ? submitBtn.querySelector('span').textContent : submitBtn.textContent;
      const isFr = document.documentElement.lang === 'fr';

      submitBtn.disabled = true;
      if (submitBtn.querySelector('span')) {
        submitBtn.querySelector('span').textContent = isFr ? 'Envoi en cours...' : 'Sending...';
      }

      statusDiv.classList.add('hidden');
      statusDiv.className = 'hidden rounded-xl p-4 text-sm font-medium';

      try {
        const formData = new FormData(form);
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData
        });

        const data = await response.json();

        if (data.success) {
          form.reset();
          if (chipsContainer) {
            chipsContainer.querySelectorAll('[data-service-chip]').forEach((c) => {
              c.classList.remove('border-midnight-indigo', 'bg-midnight-indigo/10', 'ring-2', 'ring-midnight-indigo/30');
              c.classList.add('border-border/80', 'bg-card/50');
            });
          }
          statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-green-surface text-green-dark border border-green-light/30 block';
          statusDiv.textContent = isFr 
            ? 'Merci ! Votre demande de devis a été envoyée avec succès. Nous vous contacterons dans les 24 heures.'
            : 'Thank you! Your quote request has been sent successfully. We will contact you within 24 hours.';
        } else {
          throw new Error(data.message || 'Submission failed');
        }
      } catch (err) {
        console.error('Web3Forms submit error:', err);
        statusDiv.className = 'rounded-xl p-4 text-sm font-medium bg-destructive/10 text-destructive border border-destructive/20 block';
        statusDiv.textContent = isFr 
          ? 'Désolé, une erreur est survenue lors de l\'envoi. Veuillez réessayer ou nous appeler directement.'
          : 'Sorry, there was an error submitting your request. Please try again or call us directly.';
      } finally {
        submitBtn.disabled = false;
        if (submitBtn.querySelector('span')) {
          submitBtn.querySelector('span').textContent = originalBtnText;
        }
      }
    });
  });
</script>
