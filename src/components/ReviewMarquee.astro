---
import siteSettings from '@/content/settings.json';

interface Props {
  locale: 'en' | 'fr';
  title?: string;
  subtitle?: string;
}

const { locale, title, subtitle } = Astro.props;

// Load all 8 real Google reviews from CMS content files
const reviewFiles = import.meta.glob<{ default: Record<string, unknown> }>('/src/content/reviews/*.json', { eager: true });
const reviews = Object.values(reviewFiles).map((m) => m.default as {
  author: string;
  rating: number;
  service: string;
  frService: string;
  date: string;
  textEn: string;
  textFr: string;
});

// Helper to extract initials for avatar
function getInitials(name: string): string {
  return name
    .split(' ')
    .map((n) => n[0])
    .filter(Boolean)
    .slice(0, 2)
    .join('')
    .toUpperCase();
}

// Background gradient pairs for author initials
const avatarGradients = [
  'from-blue-600 to-indigo-600',
  'from-sky-500 to-blue-600',
  'from-emerald-500 to-teal-600',
  'from-amber-500 to-orange-600',
  'from-indigo-500 to-purple-600',
  'from-cyan-500 to-blue-600',
];
---

<section class="relative overflow-hidden bg-gradient-to-b from-background via-midnight-indigo-surface/40 to-background py-4 md:py-6 lg:py-8" aria-label={isFr ? 'Avis des clients' : 'Customer Reviews'}>
  {/* Header Section */}
  <div class="mx-auto max-w-4xl px-4 text-center mb-4 md:mb-6">
    {/* Google 5.0 Rating Badge */}
    <div class="inline-flex items-center gap-2 rounded-full border border-midnight-indigo/20 bg-background px-4 py-1.5 shadow-xs mb-4">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
      </svg>
      <div class="flex items-center gap-1" role="img" aria-label="5 out of 5 stars">
        {[...Array(5)].map(() => (
          <svg class="h-3.5 w-3.5 text-amber-500 fill-amber-500" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
        ))}
      </div>
      <span class="text-xs font-semibold text-navy">
        5.0
      </span>
    </div>

    <h2 class="font-heading text-2xl font-bold tracking-tight text-navy sm:text-3xl lg:text-4xl">
      {title || (isFr ? 'Ce Que Disent Nos Clients' : 'What People Are Saying')}
    </h2>
    <p class="mt-3 max-w-xl mx-auto text-sm text-muted-foreground leading-relaxed">
      {subtitle || (isFr
        ? 'Découvrez les commentaires réels de propriétaires et commerçants à travers Ottawa.'
        : 'Don\'t just take our word for it. Here\'s what the Ottawa community has to say about our exterior cleaning services.')}
    </p>
  </div>

  {/* Infinite Marquee Container */}
  <div class="relative w-full mask-edges hover-pause flex gap-6 overflow-hidden py-2">
    {[1, 2].map((group) => (
      <ul
        class={`flex shrink-0 gap-6 animate-marquee ${group === 2 ? 'aria-hidden="true"' : ''}`}
      >
        {reviews.map((review, idx) => {
          const text = isFr ? review.textFr : review.textEn;
          const service = isFr ? review.frService : review.service;
          const initials = getInitials(review.author);
          const gradientClass = avatarGradients[idx % avatarGradients.length];

          return (
            <li class="w-[280px] sm:w-[320px] shrink-0 rounded-2xl border border-midnight-indigo/15 bg-background p-4 sm:p-5 flex flex-col justify-between shadow-[0_4px_20px_-10px_rgba(0,0,0,0.06)] hover:shadow-xl hover:border-midnight-indigo/30 transition-all duration-300">
              <div>
                {/* Header row: Quote icon + Star Rating */}
                <div class="flex items-center justify-between mb-3">
                  <svg class="h-5 w-5 text-midnight-indigo/25" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
                  </svg>
                  <div class="flex gap-0.5" role="img" aria-label={`${review.rating} out of 5 stars`}>
                    {[...Array(5)].map((_, i) => (
                      <svg
                        class={`h-3.5 w-3.5 ${i < review.rating ? 'text-amber-500 fill-amber-500' : 'text-border'}`}
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                    ))}
                  </div>
                </div>

                {/* Review Text Body — truncated to 160 chars */}
                <p class="text-xs sm:text-sm text-foreground/90 leading-relaxed font-normal mb-4">
                  "{text.length > 160 ? text.slice(0, 157) + '…' : text}"
                </p>
              </div>

              {/* Author & Service Info */}
              <div class="flex items-center gap-3 pt-3 border-t border-border/50">
                <div class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br ${gradientClass} text-white font-semibold text-xs shadow-xs`}>
                  {initials}
                </div>
                <div class="flex flex-col min-w-0 flex-1">
                  <span class="text-xs font-bold text-navy truncate">{review.author}</span>
                  <span class="text-[11px] text-muted-foreground truncate">{service}</span>
                </div>
                <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-2 py-0.5 text-[10px] font-semibold text-emerald-700 dark:text-emerald-400 shrink-0">
                  <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                  {isFr ? 'Vérifié' : 'Verified'}
                </span>
              </div>
            </li>
          );
        })}
      </ul>
    ))}
  </div>

</section>
