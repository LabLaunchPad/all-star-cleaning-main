---
import BaseLayout from './BaseLayout.astro';
import type { BreadcrumbItem } from '@/types';
interface Props {
  title: string; description: string; locale: 'en' | 'fr';
  breadcrumbs?: BreadcrumbItem[]; heroTitle?: string; heroSubtitle?: string;
  canonicalUrl?: string; ogImage?: string;
  alternateUrls?: { locale: string; url: string }[]; noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, locale, breadcrumbs = [], heroTitle, heroSubtitle, canonicalUrl, ogImage, alternateUrls, noindex, schema } = Astro.props;
---
<BaseLayout title={title} description={description} locale={locale} canonicalUrl={canonicalUrl} ogImage={ogImage} alternateUrls={alternateUrls} noindex={noindex} schema={schema}>
  <!-- Light & Clean Header Block -->
  {(breadcrumbs.length > 0 || heroTitle) && (
    <section class="relative border-b border-border/60 bg-gradient-to-b from-slate-50/80 via-sky-light/10 to-background py-6 sm:py-8 lg:py-10">
      <div class="mx-auto max-w-7xl px-4">
        {breadcrumbs.length > 0 && (
          <nav aria-label={locale === 'fr' ? "Fil d'Ariane" : 'Breadcrumb'} class="mb-3">
            <ol class="flex flex-wrap items-center gap-2 text-xs sm:text-sm text-muted-foreground">
              {breadcrumbs.map((crumb, i) => (
                <li class="flex items-center gap-2">
                  {i > 0 && <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-muted-foreground/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>}
                  {i < breadcrumbs.length - 1 ? (
                    <a href={crumb.href} class="touch-target inline-flex items-center transition-colors hover:text-midnight-indigo font-medium">{locale === 'fr' ? crumb.frLabel : crumb.label}</a>
                  ) : (
                    <span class="font-bold text-navy" aria-current="page">{locale === 'fr' ? crumb.frLabel : crumb.label}</span>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )}

        {heroTitle && (
          <div>
            <h1 class="slide-up font-heading text-2xl font-bold tracking-tight text-navy sm:text-3xl lg:text-4xl">{heroTitle}</h1>
            {heroSubtitle && <p class="fade-in delay-2 mt-1.5 max-w-2xl text-sm sm:text-base text-muted-foreground leading-relaxed">{heroSubtitle}</p>}
          </div>
        )}
      </div>
    </section>
  )}

  <main><slot /></main>
</BaseLayout>
