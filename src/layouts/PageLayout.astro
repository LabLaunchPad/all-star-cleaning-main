---
import BaseLayout from './BaseLayout.astro';
import type { BreadcrumbItem } from '@/types';
interface Props {
  title: string; description: string; locale: 'en' | 'fr';
  breadcrumbs?: BreadcrumbItem[]; heroTitle?: string; heroSubtitle?: string;
  canonicalUrl?: string; ogImage?: string;
  alternateUrls?: { locale: string; url: string }[]; noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, locale, breadcrumbs = [], heroTitle, heroSubtitle, canonicalUrl, ogImage, alternateUrls, noindex, schema } = Astro.props;
---
<BaseLayout title={title} description={description} locale={locale} canonicalUrl={canonicalUrl} ogImage={ogImage} alternateUrls={alternateUrls} noindex={noindex} schema={schema}>
  {breadcrumbs.length > 0 && (
    <nav aria-label={locale === 'fr' ? "Fil d'Ariane" : 'Breadcrumb'} class="border-b border-midnight-indigo/20 bg-navy-dark/95">
      <div class="mx-auto max-w-7xl px-4 py-2.5">
        <ol class="flex items-center gap-2 text-xs sm:text-sm text-white/70">
          {breadcrumbs.map((crumb, i) => (
            <li class="flex items-center gap-2">
              {i > 0 && <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-white/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>}
              {i < breadcrumbs.length - 1 ? (
                <a href={crumb.href} class="touch-target inline-flex items-center transition-colors hover:text-white">{locale === 'fr' ? crumb.frLabel : crumb.label}</a>
              ) : (
                <span class="font-semibold text-white" aria-current="page">{locale === 'fr' ? crumb.frLabel : crumb.label}</span>
              )}
            </li>
          ))}
        </ol>
      </div>
    </nav>
  )}
  {heroTitle && (
    <section class="relative overflow-hidden bg-gradient-to-r from-navy-dark via-midnight-indigo to-navy border-b border-midnight-indigo/20 py-8 sm:py-10 lg:py-12 text-white">
      {/* Subtle ambient blur accents */}
      <div class="pointer-events-none absolute -right-10 -top-10 h-64 w-64 rounded-full bg-white/5 blur-3xl" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-10 -left-10 h-64 w-64 rounded-full bg-sky-light/10 blur-3xl" aria-hidden="true"></div>

      <div class="relative z-10 mx-auto max-w-7xl px-4">
        <h1 class="slide-up font-heading text-2xl font-bold tracking-tight text-white sm:text-3xl lg:text-4xl">{heroTitle}</h1>
        {heroSubtitle && <p class="fade-in delay-2 mt-2 max-w-2xl text-sm sm:text-base text-white/80 leading-relaxed">{heroSubtitle}</p>}
      </div>
    </section>
  )}
  <main><slot /></main>
</BaseLayout>
