---
import PageLayout from '@/layouts/PageLayout.astro';
import CTASection from '@/components/CTASection.astro';
import GoogleReviewBadge from '@/components/GoogleReviewBadge.astro';
import { useTranslations } from '@/i18n/translations';
import { getFounderSchema, getBreadcrumbSchema } from '@/seo';
import type { BreadcrumbItem } from '@/types';
import aboutData from '@/content/about.json';
import homepageData from '@/content/homepage.json';
import siteSettings from '@/content/settings.json';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'fr' } }];
}
const { locale } = Astro.params as { locale: 'en' | 'fr' };
const t = useTranslations(locale);
const isFr = locale === 'fr';
const altLocale = isFr ? 'en' : 'fr';
const cms = aboutData;
const home = homepageData;

const breadcrumbs: BreadcrumbItem[] = [
  { label: t.nav.home, frLabel: t.nav.home, href: `/${locale}` },
  { label: t.nav.about, frLabel: t.nav.about, href: `/${locale}/about` },
];

const founderSchema = getFounderSchema(locale);
const breadcrumbSchema = getBreadcrumbSchema(breadcrumbs, locale);
---
<PageLayout
  title={isFr ? 'À Propos | All Star Cleaning Ottawa' : 'About | All Star Cleaning Ottawa'}
  description={isFr ? "Découvrez All Star Cleaning: votre partenaire de confiance pour le nettoyage extérieur à Ottawa." : "Learn about All Star Cleaning: your trusted partner for exterior cleaning in Ottawa."}
  locale={locale}
  ogImage="https://allstarcleaning.ca/og-default.jpg"
  breadcrumbs={breadcrumbs}
  heroTitle={isFr ? 'À Propos' : 'About All Star Cleaning'}
  heroSubtitle={isFr ? "Votre partenaire de confiance pour le nettoyage extérieur à Ottawa" : 'Your trusted partner for exterior cleaning across Ottawa'}
  schema={[founderSchema, breadcrumbSchema]}
  alternateUrls={[{ locale: altLocale, url: `https://allstarcleaning.ca/${altLocale}/about/` }]}
>
  <section class="py-8 sm:py-12">
    <div class="mx-auto max-w-5xl px-4">
      <div class="grid gap-8 lg:grid-cols-[1fr_380px] lg:gap-12 items-stretch">
        <!-- Left column: Main content -->
        <div class="order-2 lg:order-1 flex flex-col justify-between">
          <div>
            <!-- Review Badge -->
            <div class="flex flex-wrap items-center gap-3">
              <GoogleReviewBadge locale={locale} variant="pill" />
              <div class="flex items-center gap-2 rounded-full bg-midnight-indigo/10 px-4 py-2 border border-midnight-indigo/20">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-midnight-indigo" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                <span class="text-sm font-semibold text-navy">{t.trust.insured}</span>
              </div>
            </div>

            <div class="measure mt-8 space-y-6 text-muted-foreground leading-relaxed">
              <p class="fade-in delay-1">{isFr ? cms.storyParagraph1Fr : cms.storyParagraph1En}</p>

              <blockquote class="my-8 rounded-lg border border-midnight-indigo/20 bg-midnight-indigo/5 px-6 py-5 shadow-sm">
                <p class="font-heading text-xl text-navy italic leading-relaxed">"{isFr ? cms.blockquoteFr : cms.blockquoteEn}"</p>
                <footer class="mt-3 flex items-center gap-2 text-sm font-bold uppercase tracking-wider text-midnight-indigo">
                  <span class="h-px w-6 bg-midnight-indigo/30"></span>
                  {isFr ? 'L\'Engagement All Star' : 'The All Star Commitment'}
                </footer>
              </blockquote>

              <p class="fade-in delay-1">{isFr ? cms.storyParagraph2Fr : cms.storyParagraph2En}</p>
              <p class="fade-in delay-1">{isFr ? cms.storyParagraph3Fr : cms.storyParagraph3En}</p>
            </div>
          </div>

          <div class="mt-8 lg:hidden">
            <a href={`/${locale}/contact`} class="touch-target inline-flex items-center gap-2 rounded-full uppercase tracking-wider bg-midnight-indigo px-8 py-4 text-base font-bold text-text-on-dark transition-colors duration-200 hover:bg-midnight-indigo-dark hover:shadow-xl w-full justify-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-midnight-indigo">
              {t.cta.freeQuote}
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </a>
          </div>
          <div class="mt-8 hidden lg:block">
            <a href={`/${locale}/contact`} class="inline-flex items-center gap-2 rounded-full uppercase tracking-wider bg-midnight-indigo px-8 py-4 text-lg font-semibold text-text-on-dark transition-colors duration-200 hover:bg-midnight-indigo-dark hover:shadow-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-midnight-indigo touch-target">{t.cta.freeQuote}</a>
          </div>
        </div>

        <!-- Right column: Team image + stats + values (Auto-stretching flex layout for pixel-perfect baseline alignment) -->
        <div class="order-1 lg:order-2 flex flex-col justify-between space-y-4">
          <div class="fade-in delay-1 overflow-hidden rounded-2xl border border-border/60 shadow-md shrink-0">
            <img
              src={home.teamImage || '/images/team-at-work.jpg'}
              alt={isFr ? "L'équipe All Star Cleaning au travail" : 'All Star Cleaning team at work'}
              width="800"
              height="450"
              class="h-full w-full object-cover"
              loading="lazy"
            />
          </div>

          <!-- Refined Google Trust Card -->
          <div class="fade-in delay-2 shrink-0">
            <a 
              href={siteSettings.googleUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="touch-target group block rounded-2xl border border-border/80 bg-card p-4 sm:p-5 transition-all duration-200 hover:border-midnight-indigo/30 hover:shadow-md focus-visible:ring-2 focus-visible:ring-midnight-indigo"
              aria-label={isFr ? 'Voir nos avis Google (ouvre une nouvelle fenêtre)' : 'See our Google Reviews (opens in new window)'}
            >
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-2">
                  <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" aria-hidden="true">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                  </svg>
                  <span class="text-xs font-bold uppercase tracking-wider text-muted-foreground">{isFr ? 'Avis Google Vérifiés' : 'Verified Google Rating'}</span>
                </div>
                <div class="flex gap-0.5" role="img" aria-label="5 out of 5 stars">
                  {[...Array(5)].map(() => (
                    <svg class="h-3.5 w-3.5 text-amber-500 fill-amber-500" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                  ))}
                </div>
              </div>

              <div class="flex items-baseline justify-between">
                <div>
                  <span class="text-2xl font-extrabold text-navy">5.0</span>
                  <span class="text-xs font-medium text-muted-foreground"> / 5.0</span>
                </div>
                <span class="text-xs font-semibold text-midnight-indigo group-hover:underline inline-flex items-center gap-1">
                  {isFr ? 'Voir les avis' : 'See Reviews'}
                  <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </span>
              </div>
              <p class="mt-0.5 text-[11px] text-muted-foreground">{isFr ? `Basé sur ${siteSettings.googleReviewCount} avis vérifiés à Ottawa` : `Based on ${siteSettings.googleReviewCount} verified Ottawa reviews`}</p>
            </a>
          </div>

          <!-- Premium Bento Values Card (Flex-1 auto-stretches to match left column bottom) -->
          <div class="fade-in delay-2 flex-1 flex flex-col justify-between rounded-2xl border border-border/80 bg-gradient-to-br from-card via-white to-sky-50/60 p-4 sm:p-5 shadow-sm">
            <div class="flex items-center justify-between mb-3 pb-2.5 border-b border-border/50 shrink-0">
              <h2 class="font-heading text-base font-bold text-navy">{isFr ? 'Nos Valeurs Fondamentales' : 'Our Core Values'}</h2>
              <span class="inline-flex items-center justify-center rounded-full bg-midnight-indigo/10 px-2 py-0.5 text-[10px] font-bold text-midnight-indigo">
                {isFr ? 'Qualité Garantie' : 'Quality Guaranteed'}
              </span>
            </div>

            <div class="grid gap-2.5 flex-1 flex flex-col justify-between">
              {cms.values.map((value, idx) => {
                const valueIcons = [
                  `<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>`,
                  `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`,
                  `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>`,
                  `<path d="m13 2-2 10h7L7 22l2-10H2z"/>`
                ];
                const iconPath = valueIcons[idx % valueIcons.length];

                return (
                  <div class="flex-1 flex items-center gap-2.5 rounded-xl border border-border/60 bg-white p-2.5 px-3 shadow-2xs transition-all duration-200 hover:border-midnight-indigo/30">
                    <div class="flex h-7.5 w-7.5 shrink-0 items-center justify-center rounded-full bg-midnight-indigo/10 text-midnight-indigo">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconPath}></svg>
                    </div>
                    <span class="text-xs font-bold text-navy">{isFr ? value.fr : value.en}</span>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA SECTION — Unified component across website -->
  <CTASection locale={locale} />
</PageLayout>

