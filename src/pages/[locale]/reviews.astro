---
import PageLayout from '@/layouts/PageLayout.astro';
import CTASection from '@/components/CTASection.astro';
import { useTranslations } from '@/i18n/translations';
import { getReviewSchema, getBreadcrumbSchema } from '@/seo';
import type { ReviewData } from '@/seo';
import type { BreadcrumbItem } from '@/types';
import homepageData from '@/content/homepage.json';
import siteSettings from '@/content/settings.json';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'fr' } }];
}
const { locale } = Astro.params as { locale: 'en' | 'fr' };
const t = useTranslations(locale);
const isFr = locale === 'fr';
const altLocale = isFr ? 'en' : 'fr';
const home = homepageData;
const s = siteSettings;

// Load all reviews from CMS content files (excluding disabled services)
const reviewFiles = import.meta.glob<{ default: Record<string, unknown> }>('/src/content/reviews/*.json', { eager: true });
const allReviews = Object.values(reviewFiles)
  .map((m) => m.default as {
    author: string; rating: number; service: string; frService: string;
    date: string; textEn: string; textFr: string;
  })
  .filter((r) => r.service !== 'Snow Removal' && r.frService !== 'Déneigement');

// Sort newest first
allReviews.sort((a, b) => b.date.localeCompare(a.date));

const breadcrumbs: BreadcrumbItem[] = [
  { label: t.nav.home, frLabel: t.nav.home, href: `/${locale}` },
  { label: t.nav.reviews, frLabel: t.nav.reviews, href: `/${locale}/reviews` },
];

const aggregateRatingSchema = {
  "@type": "AggregateRating",
  "itemReviewed": { "@type": "LocalBusiness", "name": "All Star Cleaning Ottawa" },
  "ratingValue": home.googleRating.split('/')[0] || "5",
  "bestRating": "5",
  "ratingCount": String(home.googleReviewCount),
};

const reviewData: ReviewData[] = allReviews.map((r) => ({
  author: r.author,
  rating: r.rating,
  text: isFr ? r.textFr : r.textEn,
  service: isFr ? r.frService : r.service,
  date: r.date,
}));

const reviewSchemas = getReviewSchema(reviewData, locale);
const breadcrumbSchema = getBreadcrumbSchema(breadcrumbs, locale);

function getInitials(name: string) {
  const parts = name.trim().split(' ');
  if (parts.length >= 2) return `${parts[0][0]}${parts[parts.length - 1][0]}`.toUpperCase();
  return name.slice(0, 2).toUpperCase();
}

const avatarGradients = [
  'from-midnight-indigo to-sky-bold',
  'from-sky-bold to-teal-600',
  'from-indigo-600 to-midnight-indigo',
  'from-emerald-600 to-teal-600',
  'from-blue-600 to-indigo-600',
];
---
<PageLayout
  title={isFr ? 'Témoignages | All Star Cleaning Ottawa' : 'Reviews | All Star Cleaning Ottawa'}
  description={isFr ? "Lisez les témoignages de nos clients satisfaits à Ottawa. Note parfaite de 5/5 sur Google." : 'Read reviews from our satisfied Ottawa customers. Perfect 5/5 rating on Google.'}
  locale={locale}
  ogImage="https://allstarcleaning.ca/og-default.jpg"
  breadcrumbs={breadcrumbs}
  heroTitle={isFr ? 'Témoignages' : 'Customer Reviews'}
  heroSubtitle={isFr ? 'Découvrez pourquoi nos clients nous donnent 5/5 sur Google' : 'See why our customers give us a perfect 5/5 on Google'}
  alternateUrls={[{ locale: altLocale, url: `https://allstarcleaning.ca/${altLocale}/reviews/` }]}
  schema={[...reviewSchemas, aggregateRatingSchema, breadcrumbSchema]}
>
  <section class="py-10 sm:py-14 bg-background">
    <div class="mx-auto max-w-6xl px-4">
      {/* Top Header with Rating Badge, Heading, and Subtitle */}
      <div class="mb-10 text-center">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-border bg-card px-4 py-1.5 shadow-xs">
          <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
          <div class="flex gap-0.5" role="img" aria-label="5 out of 5 stars">
            {[...Array(5)].map(() => (
              <svg class="h-3.5 w-3.5 text-amber-500 fill-amber-500" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            ))}
          </div>
          <span class="text-xs font-semibold text-navy">
            5.0 ({s.googleReviewCount} {isFr ? 'avis Google vérifiés' : 'verified Google reviews'})
          </span>
        </div>

        <h2 class="font-heading text-2xl font-bold tracking-tight text-navy sm:text-3xl lg:text-4xl">
          {isFr ? 'Ce Que Disent Nos Clients' : 'What People Are Saying'}
        </h2>
        <p class="mt-3 max-w-xl mx-auto text-sm text-muted-foreground leading-relaxed">
          {isFr
            ? 'Découvrez les commentaires réels de propriétaires et commerçants à travers Ottawa.'
            : "Don't just take our word for it. Here's what the Ottawa community has to say about our exterior cleaning services."}
        </p>
      </div>

      {/* Bento Masonry Grid */}
      <div class="columns-1 md:columns-2 lg:columns-3 gap-6 space-y-6">
        {reviewData.map((review, idx) => {
          const initials = getInitials(review.author);
          const gradientClass = avatarGradients[idx % avatarGradients.length];

          return (
            <div class="break-inside-avoid mb-6 rounded-2xl border border-midnight-indigo/15 bg-card p-5 sm:p-6 shadow-[0_4px_20px_-10px_rgba(0,0,0,0.06)] hover:shadow-xl hover:border-midnight-indigo/30 transition-all duration-300 flex flex-col justify-between">
              <div>
                {/* Header row: Quote icon + Star Rating */}
                <div class="flex items-center justify-between mb-3.5">
                  <svg class="h-5 w-5 text-midnight-indigo/25" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
                  </svg>
                  <div class="flex gap-0.5" role="img" aria-label={`${review.rating} out of 5 stars`}>
                    {[...Array(5)].map((_, i) => (
                      <svg
                        class={`h-3.5 w-3.5 ${i < review.rating ? 'text-amber-500 fill-amber-500' : 'text-border'}`}
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                    ))}
                  </div>
                </div>

                {/* Review Text Body — Full Text */}
                <p class="text-sm text-foreground/90 leading-relaxed font-normal mb-5">
                  "{review.text}"
                </p>
              </div>

              {/* Author & Service Info */}
              <div class="flex items-center gap-3 pt-3.5 border-t border-border/50">
                <div class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br ${gradientClass} text-white font-semibold text-xs shadow-xs`}>
                  {initials}
                </div>
                <div class="flex flex-col min-w-0 flex-1">
                  <span class="text-xs font-bold text-navy truncate">{review.author}</span>
                  <span class="text-[11px] text-muted-foreground truncate">{review.service}</span>
                </div>
                <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-2 py-0.5 text-[10px] font-semibold text-emerald-700 dark:text-emerald-400 shrink-0">
                  <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                  {isFr ? 'Vérifié' : 'Verified'}
                </span>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA SECTION — Unified component across website -->
  <CTASection locale={locale} />
</PageLayout>
