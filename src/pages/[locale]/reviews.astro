---
import PageLayout from '@/layouts/PageLayout.astro';
import CTASection from '@/components/CTASection.astro';
import GoogleReviewBadge from '@/components/GoogleReviewBadge.astro';
import ReviewMarquee from '@/components/ReviewMarquee.astro';
import { useTranslations } from '@/i18n/translations';
import { getReviewSchema, getBreadcrumbSchema } from '@/seo';
import type { ReviewData } from '@/seo';
import type { BreadcrumbItem } from '@/types';
import homepageData from '@/content/homepage.json';
import siteSettings from '@/content/settings.json';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'fr' } }];
}
const { locale } = Astro.params as { locale: 'en' | 'fr' };
const t = useTranslations(locale);
const isFr = locale === 'fr';
const altLocale = isFr ? 'en' : 'fr';
const home = homepageData;
const s = siteSettings;

// Load all reviews from CMS content files (excluding disabled services)
const reviewFiles = import.meta.glob<{ default: Record<string, unknown> }>('/src/content/reviews/*.json', { eager: true });
const allReviews = Object.values(reviewFiles)
  .map((m) => m.default as {
    author: string; rating: number; service: string; frService: string;
    date: string; textEn: string; textFr: string;
  })
  .filter((r) => r.service !== 'Snow Removal' && r.frService !== 'Déneigement');

// Sort newest first
allReviews.sort((a, b) => b.date.localeCompare(a.date));

const breadcrumbs: BreadcrumbItem[] = [
  { label: t.nav.home, frLabel: t.nav.home, href: `/${locale}` },
  { label: t.nav.reviews, frLabel: t.nav.reviews, href: `/${locale}/reviews` },
];

const aggregateRatingSchema = {
  "@type": "AggregateRating",
  "itemReviewed": { "@type": "LocalBusiness", "name": "All Star Cleaning Ottawa" },
  "ratingValue": home.googleRating.split('/')[0] || "5",
  "bestRating": "5",
  "ratingCount": String(home.googleReviewCount),
};

const reviewData: ReviewData[] = allReviews.map((r) => ({
  author: r.author,
  rating: r.rating,
  text: isFr ? r.textFr : r.textEn,
  service: isFr ? r.frService : r.service,
  date: r.date,
}));

const reviewSchemas = getReviewSchema(reviewData, locale);
const breadcrumbSchema = getBreadcrumbSchema(breadcrumbs, locale);
---
<PageLayout
  title={isFr ? 'Témoignages | All Star Cleaning Ottawa' : 'Reviews | All Star Cleaning Ottawa'}
  description={isFr ? "Lisez les témoignages de nos clients satisfaits à Ottawa. Note parfaite de 5/5 sur Google." : 'Read reviews from our satisfied Ottawa customers. Perfect 5/5 rating on Google.'}
  locale={locale}
  ogImage="https://allstarcleaning.ca/og-default.jpg"
  breadcrumbs={breadcrumbs}
  heroTitle={isFr ? 'Témoignages' : 'Customer Reviews'}
  heroSubtitle={isFr ? 'Découvrez pourquoi nos clients nous donnent 5/5 sur Google' : 'See why our customers give us a perfect 5/5 on Google'}
  alternateUrls={[{ locale: altLocale, url: `https://allstarcleaning.ca/${altLocale}/reviews/` }]}
  schema={[...reviewSchemas, aggregateRatingSchema, breadcrumbSchema]}
>
  {/* Infinite Hilton-Style Review Marquee */}
  <ReviewMarquee locale={locale} />

  <section class="py-12 sm:py-16 bg-background border-t border-border/60">
    <div class="mx-auto max-w-6xl px-4">
      {/* Trust summary bar */}
      <div class="mb-10 text-center">
        <GoogleReviewBadge locale={locale} variant="bar" />
      </div>

      <h2 class="font-heading text-2xl font-bold tracking-tight text-navy text-center mb-8 sm:text-3xl lg:text-4xl">{isFr ? 'Tous les Avis Clients' : 'All Verified Customer Reviews'}</h2>

      {/* Review cards */}
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {reviewData.map((review, i) => {
          return (
            <div class="hover-lift rounded-2xl border border-midnight-indigo/15 bg-card p-6 flex flex-col justify-between shadow-[0_4px_20px_-10px_rgba(0,0,0,0.06)] hover:border-midnight-indigo/30 transition-all duration-200">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <div class="flex gap-0.5" role="img" aria-label={`${review.rating} out of 5 stars`}>
                    {Array.from({ length: 5 }).map((_, starIdx) => (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class={`h-4 w-4 ${starIdx < review.rating ? 'text-amber-500 fill-amber-500' : 'text-border'}`}
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                    ))}
                  </div>
                  <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-2 py-0.5 text-[10px] font-semibold text-emerald-700 dark:text-emerald-400">
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                    {isFr ? 'Avis Google' : 'Google Review'}
                  </span>
                </div>
                <p class="text-sm sm:text-base text-foreground/90 leading-relaxed font-normal">"{review.text}"</p>
              </div>
              <div class="mt-6 border-t border-border/50 pt-4 flex items-center justify-between">
                <div>
                  <p class="text-sm font-bold text-navy">{review.author}</p>
                  <p class="text-xs text-muted-foreground">{review.service}</p>
                </div>
                <span class="text-[11px] text-muted-foreground">{review.date}</span>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA SECTION — Unified component across website -->
  <CTASection locale={locale} />
</PageLayout>

